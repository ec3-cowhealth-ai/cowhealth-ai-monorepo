// CowHealth AI — Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums

enum CowStatus {
  HEALTHY
  CALVING
  HEAT_STRESS
  ALERT
  RETIRED
}

enum CollarStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  BATTERY
}

enum DataFrequency {
  HIGHER // 2 minutos
  DEFAULT // 10 minutos
  LOWER // 60 minutos
}

enum MedicalRecordType {
  CHECKUP
  PROCEDURE
  MEDICATION
}

enum ReproductiveStatus {
  OPEN
  INSEMINATED
  PREGNANT
  DRY
  POSTPARTUM
}

enum ClinicalStatus {
  STABLE
  MONITORING
  CRITICAL
  RECOVERED
  REFERRED
}

enum BreedingEligibility {
  ELIGIBLE
  INELIGIBLE
  PENDING
}

enum EstrusStatus {
  IN_ESTRUS
  NOT_IN_ESTRUS
  UNKNOWN
}

enum AlertSeverity {
  HIGH
  MEDIUM
  LOW
}

enum ActivityType {
  RUMINATION
  FEEDING
  RESTING
  LOW_ACTIVITY
  HIGH_ACTIVITY
  WALKING
}

// Auth / RBAC

model User {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  active       Boolean     @default(true)
  farmId       Int?        @map("farm_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  farm           Farm?           @relation(fields: [farmId], references: [id])
  roles          UserRole[]
  notifications  Notification[]
  userFarms      UserFarm[]
  medicalRecords  MedicalRecord[]
  clinicalRecords CowClinicalRecord[]

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique // ex: "ViewAny Farm", "Delete Cow"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles  RolePermission[]
  groups PermissionGroupPermission[]

  @@map("permissions")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserFarm {
  userId Int  @map("user_id")
  farmId Int  @map("farm_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm   Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@id([userId, farmId])
  @@map("user_farms")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model PermissionGroup {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  permissions PermissionGroupPermission[]

  @@map("permission_groups")
}

model PermissionGroupPermission {
  groupId      Int @map("group_id")
  permissionId Int @map("permission_id")

  group      PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionId])
  @@map("permission_group_permissions")
}

// Core Domain

model Farm {
  id        Int      @id @default(autoincrement())
  name      String
  cnpj      String   @unique
  address   String?
  city      String?
  state     String?
  phone     String?
  email     String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cows      Cow[]
  users     User[]
  collars   Collar[]
  userFarms UserFarm[]

  @@map("farms")
}

model Collar {
  id            Int           @id @default(autoincrement())
  name          String        @unique // device_id usado pelo MQTT para localizar o colar
  status        CollarStatus  @default(ACTIVE)
  dataFrequency DataFrequency @default(DEFAULT) @map("data_frequency") // RF10A: HIGHER=2min, DEFAULT=10min, LOWER=60min
  farmId        Int?          @map("farm_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  farm Farm? @relation(fields: [farmId], references: [id])
  cow  Cow? // 1 colar -> 1 vaca (nullable enquanto não associado)

  @@map("collars")
}

model Cow {
  id        Int       @id @default(autoincrement())
  tag       String    @unique // identificador visual da vaca
  name      String?
  breed     String? // raça (breed adotado no lugar de race)
  birthDate DateTime? @map("birth_date")
  weight    Float? // peso em kg
  photos    Json? // array de nomes de arquivo para galeria de identificacao
  status    CowStatus @default(HEALTHY)
  lastLat   Float?    @map("last_lat")
  lastLng   Float?    @map("last_lng")
  farmId    Int       @map("farm_id")
  collarId  Int?      @unique @map("collar_id") // único: garante relação 1-para-1 colar-vaca

  farm   Farm    @relation(fields: [farmId], references: [id])
  collar Collar? @relation(fields: [collarId], references: [id])

  heartRateData     HeartRateData[]
  temperatureData   TemperatureData[]
  accelerometerData AccelerometerData[]
  notifications     Notification[]

  retiredAt           DateTime?          @map("retired_at")
  retiredReason       String?            @map("retired_reason")
  lactationNumber     Int?               @map("lactation_number")
  lastCalvingDate     DateTime?          @map("last_calving_date")
  expectedCalvingDate DateTime?          @map("expected_calving_date")
  reproductiveStatus  ReproductiveStatus? @map("reproductive_status")
  sire                String?

  medicalRecords  MedicalRecord[]
  clinicalRecords CowClinicalRecord[]
  activityEvents  ActivityEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cows")
}

// Sensor Data

model HeartRateData {
  id         Int      @id @default(autoincrement())
  cowId      Int      @map("cow_id")
  bpm        Int
  measuredAt DateTime @map("measured_at") // timestamp vindo do payload MQTT
  receivedAt DateTime @default(now()) @map("received_at") // quando chegou na API

  cow Cow @relation(fields: [cowId], references: [id], onDelete: Cascade)

  @@index([cowId, measuredAt])
  @@map("heart_rate_data")
}

model TemperatureData {
  id         Int      @id @default(autoincrement())
  cowId      Int      @map("cow_id")
  celsius    Float
  measuredAt DateTime @map("measured_at")
  receivedAt DateTime @default(now()) @map("received_at")

  cow Cow @relation(fields: [cowId], references: [id], onDelete: Cascade)

  @@index([cowId, measuredAt])
  @@map("temperature_data")
}

model AccelerometerData {
  id         Int      @id @default(autoincrement())
  cowId      Int      @map("cow_id")
  accelX     Float    @map("accel_x") // eixo X do acelerometro (mpu.acc)
  accelY     Float    @map("accel_y") // eixo Y do acelerometro (mpu.acc)
  accelZ     Float    @map("accel_z") // eixo Z do acelerometro (mpu.acc)
  gyroX      Float    @map("gyro_x") // eixo X do giroscopio (mpu.gyro)
  gyroY      Float    @map("gyro_y") // eixo Y do giroscopio (mpu.gyro)
  gyroZ      Float    @map("gyro_z") // eixo Z do giroscopio (mpu.gyro)
  measuredAt DateTime @map("measured_at")
  receivedAt DateTime @default(now()) @map("received_at")

  cow Cow @relation(fields: [cowId], references: [id], onDelete: Cascade)

  @@index([cowId, measuredAt])
  @@map("accelerometer_data")
}

// Notifications

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  cowId     Int?      @map("cow_id")
  title     String
  message   String    @db.Text
  readAt    DateTime?     @map("read_at")
  severity  AlertSeverity @default(MEDIUM)
  alertType String?       @map("alert_type")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cow  Cow? @relation(fields: [cowId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@map("notifications")
}

// Medical Records

model MedicalRecord {
  id         Int               @id @default(autoincrement())
  cowId      Int               @map("cow_id")
  userId     Int               @map("user_id")
  type       MedicalRecordType
  title      String
  notes      String?           @db.Text
  recordedAt DateTime          @map("recorded_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  cow  Cow  @relation(fields: [cowId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([cowId, recordedAt])
  @@map("medical_records")
}

// Activity Events

model ActivityEvent {
  id          Int          @id @default(autoincrement())
  cowId       Int          @map("cow_id")
  type        ActivityType
  startedAt   DateTime     @map("started_at")
  durationMin Int          @map("duration_min")
  createdAt   DateTime     @default(now()) @map("created_at")

  cow Cow @relation(fields: [cowId], references: [id], onDelete: Cascade)

  @@index([cowId, startedAt])
  @@map("activity_events")
}

// Clinical Records (Prontuário Clínico Veterinário)

model CowClinicalRecord {
  id             Int      @id @default(autoincrement())
  cowId          Int      @map("cow_id")
  veterinarianId Int      @map("veterinarian_id")
  recordDate     DateTime @map("record_date")

  // Avaliação geral
  clinicalStatus ClinicalStatus @map("clinical_status")
  alertOrigin    String?        @map("alert_origin")

  // Sinais vitais (medidos/confirmados pelo veterinário)
  heartRate          Int?   @map("heart_rate")
  spo2               Float?
  bodyTemperature    Float? @map("body_temperature")
  ambientTemperature Float? @map("ambient_temperature")
  activityLevel      String? @map("activity_level")
  postureNotes       String? @map("posture_notes") @db.Text

  // Biometria
  weight             Float?
  bodyConditionScore Float? @map("body_condition_score")

  // Alimentação
  feedingNotes String? @map("feeding_notes") @db.Text

  // Avaliação clínica
  healthHistory   String? @map("health_history") @db.Text
  currentSymptoms String? @map("current_symptoms") @db.Text
  diagnosis       String? @db.Text
  treatmentPlan   String? @map("treatment_plan") @db.Text

  // Medicamentos e procedimentos
  medicationsAdministered String? @map("medications_administered") @db.Text
  vaccinationHistory      String? @map("vaccination_history") @db.Text
  surgicalProcedures      String? @map("surgical_procedures") @db.Text
  allergyNotes            String? @map("allergy_notes") @db.Text

  // Status reprodutivo (snapshot da consulta)
  reproductiveStatus  ReproductiveStatus? @map("reproductive_status")
  breedingEligibility BreedingEligibility? @map("breeding_eligibility")
  estrusStatus        EstrusStatus?        @map("estrus_status")
  inseminationWindow  String?              @map("insemination_window")
  pregnancyStatus     Boolean?             @map("pregnancy_status")
  lastCalvingDate     DateTime?            @map("last_calving_date")
  expectedCalvingDate DateTime?            @map("expected_calving_date")

  // Acompanhamento
  veterinaryRecommendations String?   @map("veterinary_recommendations") @db.Text
  followUpRequired          Boolean   @default(false) @map("follow_up_required")
  followUpDate              DateTime? @map("follow_up_date")

  // Notas gerais + soft delete
  generalNotes String?   @map("general_notes") @db.Text
  deletedAt    DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cow          Cow  @relation(fields: [cowId], references: [id], onDelete: Cascade)
  veterinarian User @relation(fields: [veterinarianId], references: [id])

  @@index([cowId, recordDate])
  @@index([veterinarianId])
  @@map("cow_clinical_records")
}
